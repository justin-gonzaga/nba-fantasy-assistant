rules_version = '2';
// APP-008 / D-64: only the API (server SDK, IAM) touches Firestore. Every client request is denied.
// Server SDKs bypass these rules; they govern the web and mobile client SDKs only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
