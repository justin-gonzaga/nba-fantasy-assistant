# Copy to .env (gitignored) and fill in:   Copy-Item env.example .env
# Never commit .env. Claude cannot read it (see .claude/settings.json).
# Check what's set, without revealing values:  python tools/doctor.py

# --- Non-secret settings (fantasy_core.settings.Settings; defaults shown)
# APP_ENV=local                 # local | ci | dev | prod
# DATA_ROOT=data                # local path or gs://<bucket>
# GCP_PROJECT=
# YAHOO_LEAGUE_KEY=             # discovered in DISC-002
# USER_TZ=Australia/Sydney
# AWAKE_START=07:00
# AWAKE_END=23:00

# Owner step 3: Yahoo developer app (Fantasy Sports: Read)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Owner step 4: Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=

# Later (D-36 natural-language questions): console.anthropic.com API key; billed separately from Claude Pro
ANTHROPIC_API_KEY=
